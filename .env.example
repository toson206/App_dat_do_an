# =====================================================
# DX-ORDER LOCAL ENVIRONMENT CONFIGURATION
# =====================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dx_order
POSTGRES_PORT=5432

# --- pgAdmin 4 ---
PGADMIN_DEFAULT_EMAIL=admin@dxtech.asia
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Backend FastAPI ---
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BASE_URL=http://localhost:8000

# Connection string for local run (outside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dx_order
